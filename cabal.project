with-compiler: ghc-9.14.1

-- To develop against a local LH checkout, list the LH sub-packages here;
-- remove them and `cabal update` to build against the hackage version.
-- To run Diff's test and benchmark, add "." to the list of packages
packages:
  ./Diff-liquidhaskell
  ../liquidhaskell
  ../liquidhaskell/liquidhaskell-boot
  ../liquidhaskell/liquid-prelude
  ../liquidhaskell/liquid-fixpoint

tests: True
benchmarks: True
